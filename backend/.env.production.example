# ==============================================================================
# RentFair Backend — Production Environment Variables Configuration
# ==============================================================================

# 1. SerpApi Engine Configuration
SERPAPI_API_KEY=your_serpapi_production_key_here

# 2. HTTP Port
PORT=8080

# 3. Database Connection (PostgreSQL or H2 fallback)
DATABASE_URL=jdbc:h2:mem:rentfair;DB_CLOSE_DELAY=-1;MODE=PostgreSQL

# 4. CORS Allowed Origins
CORS_ALLOWED_ORIGINS=*
