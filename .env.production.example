# ==============================================================================
# RentFair — Production Environment Variables Configuration
# ==============================================================================

# 1. SerpApi Engine Configuration (REQUIRED for Live Search)
# Register at https://serpapi.com to retrieve your API key.
SERPAPI_API_KEY=your_serpapi_production_key_here

# 2. HTTP Port (Assigned dynamically by cloud hosts such as Render, Railway, Heroku)
PORT=8080

# 3. Database Connection
# Defaults to in-memory H2 with PostgreSQL compatibility (zero-config, self-contained).
# For cloud PostgreSQL (Neon, Supabase, Render, Railway, AWS RDS), supply the standard URI:
# DATABASE_URL=postgresql://user:password@host:5432/rentfair_db
DATABASE_URL=jdbc:h2:mem:rentfair;DB_CLOSE_DELAY=-1;MODE=PostgreSQL

# 4. CORS Allowed Origins
# If frontend is deployed separately (e.g. on Vercel/Netlify), supply your frontend domain:
# CORS_ALLOWED_ORIGINS=https://your-rentfair-app.vercel.app,https://your-custom-domain.com
CORS_ALLOWED_ORIGINS=*

# 5. Frontend API Base URL (ONLY needed if deploying Frontend separately from Backend)
# For unified single-JAR or Docker deployments, leave this EMPTY to use same-origin relative /api.
# VITE_API_BASE_URL=https://your-backend-api.onrender.com
