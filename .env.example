# RentFair Environment Configuration Template
# Copy this file to .env and provide your actual API keys. Never commit the actual .env file.

# SerpApi Key (Get free key at https://serpapi.com)
SERPAPI_API_KEY=your_serpapi_api_key_here

# PostgreSQL Database Configuration (Optional for production; defaults to embedded H2 in dev)
# DATABASE_URL=jdbc:postgresql://localhost:5432/rentfair
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_DRIVER=org.postgresql.Driver

# Server Port
PORT=8080

# Frontend API URL (for Vite React app)
VITE_API_BASE_URL=http://localhost:8080
